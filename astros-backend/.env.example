# ==============================================================================
# AstroOS Backend Environment Configuration Example
# Copy this file to '.env' and adjust values for your local environment:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / macOS:        cp .env.example .env
# ==============================================================================

# --- Database Configuration ---
# DATABASE_URL: PostgreSQL connection string used at runtime (Required).
# Example: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/astros_db

# TEST_DATABASE_URL: Isolated test database used exclusively by pytest (Required for tests).
# Safety check in tests/conftest.py strictly requires database name 'astros_test_db'.
TEST_DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/astros_test_db

# --- Weather Provider Configuration (Open-Meteo) ---
# OPEN_METEO_BASE_URL: Base URL for hourly weather forecast queries (Optional, default: https://api.open-meteo.com/v1/forecast).
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# WEATHER_REQUEST_TIMEOUT_SECONDS: Timeout in seconds for weather HTTP requests (Optional, float, default: 10.0).
WEATHER_REQUEST_TIMEOUT_SECONDS=10.0

# WEATHER_CACHE_TTL_SECONDS: In-memory TTL cache duration in seconds for forecast responses (Optional, integer, default: 1800).
WEATHER_CACHE_TTL_SECONDS=1800

# --- Light Pollution Configuration ---
# LIGHT_POLLUTION_DATA_PATH: Path to local raster/grid dataset (.asc or .json) (Optional, default: empty/None).
# If empty, the system checks for DARKSKYSITES_API_KEY, falling back to 'unavailable' if neither is set.
LIGHT_POLLUTION_DATA_PATH=

# DARKSKYSITES_API_KEY: API key for DarkSkySites zenith SQM lookup (Optional, default: empty/None).
# Obtain key at https://darkskysites.com — do NOT commit real keys to version control.
DARKSKYSITES_API_KEY=

# DARKSKYSITES_BASE_URL: DarkSkySites API endpoint (Optional, default: https://darkskysites.com/api/sqm).
DARKSKYSITES_BASE_URL=https://darkskysites.com/api/sqm

# DARKSKYSITES_TIMEOUT_SECONDS: Timeout in seconds for DarkSkySites HTTP requests (Optional, float, default: 10.0).
DARKSKYSITES_TIMEOUT_SECONDS=10.0

# DARKSKYSITES_CACHE_TTL_SECONDS: In-memory TTL cache duration in seconds for SQM results (Optional, integer, default: 86400).
DARKSKYSITES_CACHE_TTL_SECONDS=86400

# --- API Documentation & Security ---
# ENABLE_API_DOCS: Enables or disables /docs (Swagger UI) and /redoc (Optional, boolean string, default: true).
# Set to 'false' in production environments to prevent public schema exploration.
ENABLE_API_DOCS=true

# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed web origins (Optional, default: empty).
# When left empty, CORS middleware is disabled and cross-origin browser requests are blocked.
# Production example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
CORS_ALLOWED_ORIGINS=

# --- Authentication (JWT) ---
# JWT_SECRET_KEY: Cryptographically random secret for signing JWT tokens.
# Required when ENVIRONMENT=production. Optional in development.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit a real secret to version control.
JWT_SECRET_KEY=7f3c9a2e8b1d6f405a7c9e2b3d8f1a6c5e0b9d4f2a7c8e1b6d3f905a2c7e4b8

# JWT_ALGORITHM: Algorithm used to sign JWTs (Optional, default: HS256).
# Supported values: HS256, HS384, HS512.
JWT_ALGORITHM=HS256

# ACCESS_TOKEN_EXPIRE_MINUTES: Access token validity period in minutes (Optional, default: 20).
ACCESS_TOKEN_EXPIRE_MINUTES=20

# REFRESH_TOKEN_EXPIRE_DAYS: Refresh token validity period in days (Optional, default: 7).
REFRESH_TOKEN_EXPIRE_DAYS=7

# ENABLE_PUBLIC_REGISTRATION: Allow public user self-registration (Optional, boolean, default: true).
# Set to 'false' to require administrator-provisioned accounts only.
ENABLE_PUBLIC_REGISTRATION=true

# ENVIRONMENT: Deployment environment (Optional, default: development).
# Set to 'production' to enforce strict JWT_SECRET_KEY validation at startup.
ENVIRONMENT=development

